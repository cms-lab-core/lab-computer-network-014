name: lab-computer-network-014

topology:
  groups:
    routers:
      kind: linux
      image: quay.io/frrouting/frr:containerlab-10.7.1
    hosts:
      kind: linux
      image: ghcr.io/nicolaka/netshoot:v0.16
  nodes:
    pc1:
      group: hosts
      labels:
        flow_icon: pc
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - ip link set eth1 up
        - ip addr replace 10.14.1.10/24 dev eth1
    r1:
      group: routers
      labels:
        flow_icon: router
      binds:
        - configs/r1/daemons:/etc/frr/daemons
        - configs/r1/frr.conf:/etc/frr/frr.conf
      exec:
        - /bin/sh -c "echo admin:admin | chpasswd"
        - sysctl -w net.ipv4.ip_forward=1
    r2:
      group: routers
      labels:
        flow_icon: router
      binds:
        - configs/r2/daemons:/etc/frr/daemons
        - configs/r2/frr.conf:/etc/frr/frr.conf
      exec:
        - /bin/sh -c "echo admin:admin | chpasswd"
        - sysctl -w net.ipv4.ip_forward=1
    dns1:
      kind: linux
      image: internetsystemsconsortium/bind9:9.20
      labels:
        flow_icon: server
      binds:
        - configs/dns1/named.conf:/etc/bind/named.conf
        - configs/dns1/db.lab.example:/var/lib/bind/db.lab.example
      exec:
        - ip link set eth1 up
        - ip addr replace 10.14.20.53/24 dev eth1
        - ip route replace 10.14.1.0/24 via 10.14.20.1 dev eth1
    web1:
      group: hosts
      labels:
        flow_icon: server
      exec:
        - /bin/sh -c "adduser -D -s /bin/sh admin 2>/dev/null || true"
        - /bin/sh -c "echo admin:admin | chpasswd"
        - ssh-keygen -A
        - mkdir -p /run/sshd
        - /bin/sh -c "echo PasswordAuthentication=yes >> /etc/ssh/sshd_config"
        - /usr/sbin/sshd
        - ip link set eth1 up
        - ip addr replace 10.14.30.80/24 dev eth1
        - ip route replace 10.14.1.0/24 via 10.14.30.1 dev eth1
        - mkdir -p /tmp/www
        - /bin/sh -c "printf '<html><body>cms-network-capstone-ok</body></html>\\n' > /tmp/www/index.html"
  links:
    - endpoints: ["pc1:eth1", "r1:eth1"]
    - endpoints: ["r1:eth2", "r2:eth1"]
    - endpoints: ["r2:eth2", "dns1:eth1"]
    - endpoints: ["r2:eth3", "web1:eth1"]
